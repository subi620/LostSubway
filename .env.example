# 공공데이터포털(data.go.kr) > 마이페이지 > 개발계정 > 활용신청 상세 > "일반 인증키(Decoding)" 값을 붙여넣으세요.
# Encoding 키(%가 들어간 값)를 넣어도 자동으로 처리합니다.
# 필요한 API: 경찰청_포털기관 습득물정보 조회 서비스
LOST112_SERVICE_KEY=

# 로컬 서버 포트
PORT=5600

# (선택) 보관 기간 / 갱신 주기
# SYNC_DAYS=30          # DB에 둘 기간(일). 처음 켤 때와 하루 한 번 이만큼 다시 받음 (하루당 API 1회 호출)
# REFRESH_DAYS=5        # 주기 갱신 때 다시 받을 최근 기간(일)
# REFRESH_MINUTES=60    # 주기 갱신 간격(분)
